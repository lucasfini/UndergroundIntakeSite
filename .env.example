# Zendesk Configuration
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=your-email@example.com
ZENDESK_API_TOKEN=your-api-token

# Zendesk Custom Field IDs (Optional - get these from your Zendesk admin panel)
# See FIELD_IDS_TEMPLATE.md for instructions on finding these IDs
ZENDESK_FIELD_SERVICE_TYPE=46477062161683
ZENDESK_FIELD_SELECTED_PACKAGE=46478565970195 
ZENDESK_FIELD_SELECTED_ADDONS=46478558931219
ZENDESK_FIELD_TOTAL_PRICE=46478619908115

# Email Configuration (Optional - for SendGrid or Resend)
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@undergrounddesign.ca

# Microsoft Authentication
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_TENANT_ID=your-tenant-id
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=your-client-id
NEXT_PUBLIC_AZURE_AD_TENANT_ID=your-tenant-id

# Admin Emails (comma-separated)
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Database Configuration
# Local Development (SQLite - simple but different from production):
DATABASE_URL="file:./dev.db"

# Local Development (PostgreSQL - recommended, matches production):
# DATABASE_URL="postgresql://underground:devpassword@localhost:5432/underground_intake"

# Production (PostgreSQL - set on your server):
# DATABASE_URL="postgresql://username:password@your-server-host:5432/your_database_name"
